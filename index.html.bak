<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>San Code | Portafolio Personal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .font-mono-custom {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Animación suave para los corchetes */
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(8px); }
            15% { opacity: 1; transform: translateY(0); }
            85% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-8px); }
        }
        .animate-phrase {
            animation: fadeInOut 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen selection:bg-[#E60000] selection:text-white">

    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 w-full z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-900">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="text-xl font-bold tracking-tighter flex items-center gap-2">
                <span class="text-[#E60000] font-mono-custom">[</span> San Code <span class="text-[#E60000] font-mono-custom">]</span>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm text-zinc-400 font-medium">
                <a href="#about" class="hover:text-zinc-100 transition-colors">Perfil</a>
                <a href="#projects" class="hover:text-zinc-100 transition-colors">Proyectos</a>
                <a href="#contact" class="hover:text-zinc-100 transition-colors">Contacto</a>
            </nav>
            <div class="flex items-center gap-4">
                <a href="https://github.com/EdinsonSantiago89" target="_blank" class="text-zinc-400 hover:text-zinc-100 transition-colors">
                    GitHub
                </a>
                <a href="https://www.linkedin.com/in/edinson-santiago-7621ab24a" target="_blank" class="px-4 py-2 text-xs font-medium bg-zinc-900 hover:bg-[#E60000] text-zinc-200 hover:text-white border border-zinc-800 hover:border-[#E60000] rounded-full transition-all duration-300">
                    LinkedIn
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section con Animación de Corchetes -->
    <section class="min-h-screen flex flex-col items-center justify-center px-6 pt-20 relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:32px_32px] opacity-20 pointer-events-none"></div>
        
        <div class="max-w-4xl mx-auto text-center z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-400 mb-8">
                <span class="w-2 h-2 rounded-full bg-[#E60000] animate-pulse"></span>
                Frontend Developer & Systems Specialist
            </div>

            <h1 class="text-4xl md:text-7xl font-bold tracking-tight text-white mb-6">
                Ingeniería limpia para <br />
                <span class="text-[#E60000]">experiencias digitales</span>
            </h1>

            <!-- Contenedor Animado de Corchetes -->
            <div class="my-10 h-20 flex items-center justify-center font-mono-custom text-2xl md:text-4xl font-bold text-zinc-200">
                <span class="text-[#E60000] mx-2 text-3xl md:text-5xl">[</span>
                <div id="bracket-container" class="inline-block min-w-[280px] md:min-w-[420px] text-center">
                    <span id="animated-text" class="animate-phrase text-[#E60000]">lo que piensas</span>
                </div>
                <span class="text-[#E60000] mx-2 text-3xl md:text-5xl">]</span>
            </div>

            <p class="text-zinc-400 text-base md:text-lg max-w-xl mx-auto mb-10 font-light">
                Construyendo soluciones de software eficientes, interfaces minimalistas de alto rendimiento y arquitecturas web escalables.
            </p>

            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="#projects" class="px-8 py-3.5 bg-zinc-100 hover:bg-white text-zinc-950 font-medium text-sm rounded-full transition-all shadow-lg shadow-white/5">
                    Ver Proyectos
                </a>
                <a href="#contact" class="px-8 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 font-medium text-sm border border-zinc-800 rounded-full transition-all">
                    Conectar
                </a>
            </div>
        </div>
    </section>

    <!-- Perfil y Competencias Técnicas -->
    <section id="about" class="py-24 px-6 border-t border-zinc-900 bg-zinc-950/50">
        <div class="max-w-6xl mx-auto">
            <div class="mb-16">
                <h2 class="text-xs uppercase tracking-widest text-[#E60000] font-mono-custom mb-3">// Competencias</h2>
                <h3 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Capacidades Técnicas</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Skill Card 1 -->
                <div class="p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-[#E60000]/50 transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-[#E60000] font-mono-custom mb-6 group-hover:scale-110 transition-transform">
                        01
                    </div>
                    <h4 class="text-lg font-semibold text-white mb-3">Soporte y Tecnologías</h4>
                    <p class="text-zinc-400 text-sm leading-relaxed font-light">
                        Mantenimiento avanzado, parametrización y soporte técnico integral en infraestructuras de programas informáticos y entornos de desarrollo.
                    </p>
                </div>

                <!-- Skill Card 2 -->
                <div class="p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-[#E60000]/50 transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-[#E60000] font-mono-custom mb-6 group-hover:scale-110 transition-transform">
                        02
                    </div>
                    <h4 class="text-lg font-semibold text-white mb-3">Bases de Datos</h4>
                    <p class="text-zinc-400 text-sm leading-relaxed font-light">
                        Gestión, modelado y administración optimizada de bases de datos relacionales y no relacionales para garantizar la integridad y velocidad de la información.
                    </p>
                </div>

                <!-- Skill Card 3 -->
                <div class="p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-[#E60000]/50 transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-[#E60000] font-mono-custom mb-6 group-hover:scale-110 transition-transform">
                        03
                    </div>
                    <h4 class="text-lg font-semibold text-white mb-3">Aplicaciones Web y Escritorio</h4>
                    <p class="text-zinc-400 text-sm leading-relaxed font-light">
                        Instalación, despliegue y parametrización avanzada de aplicaciones de escritorio y soluciones web modernas con enfoque minimalista y de alta gama.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sección de Proyectos y Aplicaciones -->
    <section id="projects" class="py-24 px-6 border-t border-zinc-900">
        <div class="max-w-6xl mx-auto">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
                <div>
                    <h2 class="text-xs uppercase tracking-widest text-[#E60000] font-mono-custom mb-3">// Portafolio</h2>
                    <h3 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Proyectos y Aplicaciones</h3>
                </div>
                <p class="text-zinc-400 text-sm mt-4 md:mt-0 font-light max-w-md">
                    Una selección de desarrollos web, automatizaciones y herramientas funcionales construidas con precisión.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Project Card 1 -->
                <div class="group rounded-2xl bg-zinc-900/30 border border-zinc-800/80 p-8 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <span class="text-xs font-mono-custom text-[#E60000] bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">Web App</span>
                            <span class="text-xs text-zinc-500 font-mono-custom">2026</span>
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 group-hover:text-[#E60000] transition-colors">San Code Platform</h4>
                        <p class="text-zinc-400 text-sm leading-relaxed font-light mb-6">
                            Aplicación web interactiva desarrollada con componentes modernos, animaciones fluidas y pasarela de integración optimizada.
                        </p>
                    </div>
                    <div class="flex items-center gap-4 pt-4 border-t border-zinc-800/60">
                        <a href="https://github.com/EdinsonSantiago89" target="_blank" class="text-xs font-medium text-zinc-300 hover:text-white flex items-center gap-1.5 transition-colors">
                            Ver Código →
                        </a>
                    </div>
                </div>

                <!-- Project Card 2 -->
                <div class="group rounded-2xl bg-zinc-900/30 border border-zinc-800/80 p-8 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <span class="text-xs font-mono-custom text-[#E60000] bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">Sistemas & Automatización</span>
                            <span class="text-xs text-zinc-500 font-mono-custom">2026</span>
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 group-hover:text-[#E60000] transition-colors">Automatización y Escritorio</h4>
                        <p class="text-zinc-400 text-sm leading-relaxed font-light mb-6">
                            Herramientas de parametrización de software, gestión de bases de datos y flujos automatizados para optimizar procesos operativos.
                        </p>
                    </div>
                    <div class="flex items-center gap-4 pt-4 border-t border-zinc-800/60">
                        <a href="https://github.com/EdinsonSantiago89" target="_blank" class="text-xs font-medium text-zinc-300 hover:text-white flex items-center gap-1.5 transition-colors">
                            Ver Repositorio →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer / Contacto -->
    <footer id="contact" class="py-20 px-6 border-t border-zinc-900 bg-zinc-950 text-center">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-xs uppercase tracking-widest text-[#E60000] font-mono-custom mb-3">// Contacto</h2>
            <h3 class="text-3xl font-bold text-white mb-6">Conectemos y construyamos juntos</h3>
            <p class="text-zinc-400 text-sm max-w-md mx-auto mb-10 font-light">
                ¿Tienes un proyecto en mente o quieres conocer más sobre mi trabajo técnico? Explora mis perfiles oficiales o contáctame.
            </p>
            <div class="flex items-center justify-center gap-6 mb-16">
                <a href="https://github.com/EdinsonSantiago89" target="_blank" class="px-6 py-3 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-200 hover:text-white hover:border-[#E60000] text-sm font-medium transition-all">
                    GitHub Profile
                </a>
                <a href="https://www.linkedin.com/in/edinson-santiago-7621ab24a" target="_blank" class="px-6 py-3 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-200 hover:text-white hover:border-[#E60000] text-sm font-medium transition-all">
                    LinkedIn Network
                </a>
            </div>
            <p class="text-xs text-zinc-600 font-mono-custom">
                © 2026 San Code [ Edinson Santiago ]. Todos los derechos reservados.
            </p>
        </div>
    </footer>

    <!-- Script para rotar dinámicamente las frases en los corchetes -->
    <script>
        const phrases = [
            "lo que piensas",
            "lo que necesitas",
            "se ejecuta",
            "todo en San Code"
        ];
        
        let currentIndex = 0;
        const textElement = document.getElementById("animated-text");

        setInterval(() => {
            currentIndex = (currentIndex + 1) % phrases.length;
            textElement.style.animation = 'none';
            textElement.offsetHeight; // Trigger reflow
            textElement.textContent = phrases[currentIndex];
            textElement.style.animation = 'fadeInOut 3s ease-in-out infinite';
        }, 3000);
    </script>
</body>
</html>